#include <windows.h>
#include <winver.h>
#include "version.h"

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "drawcursor.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DRAWCURSOR_VERSION_NUMERIC
 PRODUCTVERSION DRAWCURSOR_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DrawCursor"
            VALUE "FileDescription", "DrawCursor mouse pointer redraw utility"
            VALUE "FileVersion", DRAWCURSOR_VERSION_STRING
            VALUE "InternalName", "DrawCursor"
            VALUE "OriginalFilename", DRAWCURSOR_ORIGINAL_FILENAME
            VALUE "ProductName", "DrawCursor"
            VALUE "ProductVersion", DRAWCURSOR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
